+void aurora_set_texture_anisotropy(uint16_t max) {
+  const uint16_t clamped = max < 1 ? 1 : (max > 16 ? 16 : max);
+  if (aurora::webgpu::g_graphicsConfig.textureAnisotropy != clamped) {
+    aurora::webgpu::g_graphicsConfig.textureAnisotropy = clamped;
+    aurora::gx::texture::invalidate_bindings();
+  }
+}
+
+void aurora_set_msaa(uint32_t samples) {
+  aurora::webgpu::g_pendingMsaa.store(samples >= 4 ? 4 : 1, std::memory_order_release);
+  aurora::window::push_custom_event(aurora::window::CustomEvent::RefreshSurface);
+}
