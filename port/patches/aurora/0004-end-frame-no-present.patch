+/**
+ * Like aurora_end_frame, but submits the frame's commands without acquiring a surface texture or
+ * presenting: the EFB still holds the frame's picture for the next frame. For frame-rate limits
+ * that skip presents without slowing the caller.
+ */
+void aurora_end_frame_no_present();
+/** Presenting frames ended on this thread whose present the render worker has not finished. */
+uint32_t aurora_presents_in_flight();
 
 #ifdef __cplusplus
 }
