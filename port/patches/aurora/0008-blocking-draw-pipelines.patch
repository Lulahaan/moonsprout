 void aurora_set_background_input(bool value);
+/**
+ * mppm: when true, a GX or clear draw whose pipeline is not built yet waits for it (the frame
+ * stalls) instead of being skipped for that frame. Skipped draws show as half-built pictures
+ * (missing geometry, untextured quads) while a cold pipeline cache fills; prewarmed and cached
+ * pipelines never wait. Default false (Aurora's asynchronous behaviour).
+ */
+void aurora_set_blocking_pipelines(bool value);
 void aurora_set_resampler(AuroraSampler sampler);
 /** Sets the clock timescale. Default 1.0f. 0.0f is paused. Range 0.0f-16.0f. */
 void aurora_set_timescale(float scale);
