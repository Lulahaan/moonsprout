+// EFB generation of the last finished frame: a preserved frame can only load the previous picture
+// from the same textures (a recreated EFB starts undefined, shown as black).
+static uint32_t g_finishedEfbGeneration = UINT32_MAX;
+
+bool preserve_efb() noexcept {
+  if (!g_recorder.active() || g_recorder.inOffscreen || g_recorder.currentRenderPass != 0) {
+    return false;
+  }
+  if (g_finishedEfbGeneration != webgpu::g_frameBufferGeneration) {
+    return false;
+  }
+  auto& pass = current_render_passes()[0];
+  if (pass.hasDraws) {
+    return false;
+  }
+  for (uint32_t i = 0; i < pass.colorAttachmentCount; ++i) {
+    pass.colorAttachments[i].clear = false; // loadOp stays Undefined: encoded as Load
+  }
+  pass.clearDepth = false;
+  return true;
+}
+
 void finish() {
   ZoneScoped;
   if (!g_recorder.active()) {
@@ -1169,6 +1191,7 @@ void finish() {
     enqueue_pass(frame, g_recorder.currentRenderPass);
     g_recorder.currentRenderPass = UINT32_MAX;
   }
+  g_finishedEfbGeneration = webgpu::g_frameBufferGeneration;
 }
 
