/*
 * The passive overlay above the game: toasts, the FPS pill, the shader-compile notice
 * (DESIGN.md 5.14). Toast DOM, as the overlay builds it:
 *   <toast class="info|success|warning|error|achievement|controller">
 *     <heading><toast-title/><icon/></heading><message>...</message><progress/></toast>
 * The type is drawn as a pellet left of the heading and repeated by the heading icon, so it is
 * never told by colour alone. Toasts are hidden on the `transitionend` of their filter.
 */
body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: var(--font-size-base);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    z-index: 2;
    pointer-events: none;
}

/* ---- Toasts ---- */

toast {
    --toast-pellet: #2F7BEA;

    position: absolute;
    top: 32dp;
    right: 32dp;
    display: flex;
    flex-flow: column;
    gap: 4dp;
    min-width: 280dp;
    max-width: 400dp;
    padding: 14dp 18dp 14dp 44dp;
    overflow: hidden;
    border-radius: 20dp;
    border-width: 1dp;
    border-color: var(--toast-border-color);
    background-color: var(--surface-toast);
    decorator: radial-gradient(circle 7dp at 23dp 25dp, var(--toast-pellet) 0%, var(--toast-pellet) 80%, rgba(255, 255, 255, 0%) 100%);
    backdrop-filter: var(--blur-bar);
    box-shadow: 0 8dp 24dp 0 rgba(5, 11, 26, 55%);
    filter: opacity(0);
    transform: translateX(16dp);
    transition: filter 0.18s cubic-in, transform 0.18s cubic-in;
}

toast[open] {
    filter: opacity(1);
    transform: translateX(0dp);
    transition: filter 0.16s cubic-out, transform 0.32s back-out;
}

toast.success { --toast-pellet: #5FBF3A; }
toast.warning,
toast.controller-warning { --toast-pellet: #FFD23F; }
toast.error { --toast-pellet: #E8392B; }
toast.achievement { --toast-pellet: #F7B6D2; }
toast.controller { --toast-pellet: #6FB6DE; }

toast heading {
    display: flex;
    gap: 10dp;
    align-items: center;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--toast-heading-color);
}

toast heading > toast-title {
    flex: 1 0 auto;
}

toast heading > row {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    gap: 4dp;
}

toast message {
    display: flex;
    flex-flow: column;
    gap: 4dp;
    font-size: var(--font-size-base);
    line-height: 1.35;
    color: rgba(var(--color-text-rgb), 80%);
}

toast message row {
    display: flex;
}

toast message row.muted {
    color: var(--text-tertiary);
}

toast icon {
    width: 1.2em;
    height: 1.2em;
    font-size: 1.2em;
}

/* The remaining time: a thin sun line along the bottom edge. */
toast progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3dp;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
}

toast progress fill {
    border-radius: 0;
    box-shadow: none;
}

/* Centred notices: the menu hint and the missing-controller warning. */
toast.menu-notification {
    right: auto;
    left: 50%;
    max-width: 90%;
    transform: translateX(-50%) translateY(-12dp);
}

toast.menu-notification[open] {
    transform: translateX(-50%) translateY(0dp);
}

/* The missing-controller warning stays for as long as Player 1 has no device, so it keeps clear of
   the HUD: top centre, under the menu hint and the open F1 bar (16dp + 64dp + a 16dp gap) rather
   than over the Pikmin counter. Centred with auto margins: a fixed width wider than the toast's
   max-width made translateX(-50%) land about 76px right of centre. */
toast.controller-warning,
toast.controller-warning[open] {
    top: 96dp;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: 420dp;
    max-width: 90%;
}

toast.controller-warning {
    transform: translateY(-12dp);
}

toast.controller-warning[open] {
    transform: translateY(0dp);
}

toast.menu-notification message {
    align-items: center;
    text-align: center;
}

toast.menu-notification message row {
    align-items: center;
    gap: 6dp;
}

/* ---- FPS pill (corner set by the overlay) ---- */

fps {
    display: none;
    position: absolute;
    z-index: 99;
    height: 26dp;
    padding: 0 12dp;
    border-radius: 13dp;
    border-width: 1dp;
    border-color: rgba(var(--color-border-rgb), 50%);
    background-color: var(--surface-bar);
    font-family: var(--font-family-monospace);
    font-size: var(--font-size-xs);
    line-height: 24dp;
    color: var(--color-text);
    pointer-events: none;
    white-space: nowrap;
}

fps[open] {
    display: block;
}

fps[corner=tl] { top: 12dp; left: 12dp; }
fps[corner=tr] { top: 12dp; right: 12dp; }
fps[corner=bl] { bottom: 12dp; left: 12dp; }
fps[corner=br] { bottom: 12dp; right: 12dp; }

/* ---- Shader compile notice: a glass pill with a turning leaf ---- */

pipeline-progress {
    position: absolute;
    left: 16dp;
    bottom: 16dp;
    z-index: 100;
    display: flex;
    flex-flow: column;
    /* A fixed, compact width: shrink-to-fit lets the progress bar stretch it across the window. */
    width: 260dp;
    max-width: 90%;
    padding: 8dp 16dp 8dp 12dp;
    overflow: hidden;
    border-radius: 20dp;
    border-width: 1dp;
    border-color: rgba(var(--color-border-rgb), 50%);
    background-color: var(--surface-bar);
    filter: opacity(0);
    transition: filter 0.2s cubic-out;
    pointer-events: none;
}

pipeline-progress[open] {
    filter: opacity(1);
}

/* Over the start menu its footer owns the bottom band. */
pipeline-progress.over-menu {
    left: auto;
    right: 16dp;
    bottom: auto;
    top: 16dp;
}

pipeline-progress status {
    display: flex;
    align-items: center;
    gap: 8dp;
    font-size: var(--font-size-md);
    white-space: nowrap;
}

pipeline-progress icon {
    flex: 0 0 auto;
    width: 1.2em;
    height: 1.2em;
    font-size: 1.2em;
    color: var(--color-accent);
    decorator: text("&#xea35;" center center);
    transform-origin: center;
    animation: 1.1s linear infinite pipeline-spinner-spin;
}

@keyframes pipeline-spinner-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@media (max-height: 640dp) {
    toast {
        top: 16dp;
        right: 16dp;
    }

    toast.controller-warning {
        bottom: 16dp;
    }

    toast.menu-notification {
        top: 16dp;
    }
}

/* ---- Accessibility ---- */

body.reduce-motion.reduce-motion.reduce-motion.reduce-motion toast,
body.reduce-motion.reduce-motion.reduce-motion.reduce-motion toast[open] {
    transform: none;
}

body.reduce-motion.reduce-motion.reduce-motion.reduce-motion toast.menu-notification,
body.reduce-motion.reduce-motion.reduce-motion.reduce-motion toast.controller-warning {
    transform: translateX(-50%);
}

body.reduce-motion.reduce-motion.reduce-motion.reduce-motion pipeline-progress icon {
    animation: 1.2s linear-in-out infinite alternate pipeline-pulse;
}

@keyframes pipeline-pulse {
    from { opacity: 0.4; }
    to { opacity: 1; }
}

body.high-contrast.high-contrast.high-contrast.high-contrast toast {
    border-color: var(--color-text);
    backdrop-filter: none;
}
