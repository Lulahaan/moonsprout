/*
 * In-game additions on top of popup.rcss and overlay.rcss (package W5; DESIGN.md 5.14, 8):
 * the scrim behind the bar and its windows, the overlay's corner stack (FPS pill + "Cheats on"
 * badge), the toast stack and the menu hint's key caps.
 */

/* ---- Scrim (its own passive document, below every other one) ---- */

body.scrim {
    z-index: -50;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    pointer-events: none;
    background-color: rgba(5, 11, 26, 0%);
    transition: background-color 0.2s cubic-out;
}

body.scrim.level-1 { background-color: rgba(5, 11, 26, 30%); }
body.scrim.level-2 { background-color: rgba(5, 11, 26, 50%); }

/* ---- The bar ---- */

body.in-game-bar popup bar-status prompt {
    cursor: pointer;
    pointer-events: auto;
}

body.in-game-bar popup bar-status prompt label {
    font-family: var(--font-family-body);
}

body.in-game-bar popup bar-status span.fps {
    color: var(--color-text);
}

body.in-game-bar popup bar-status span.off {
    display: none;
}

/* Narrow viewports (Original aspect on a wide window confines the UI to the 4:3 picture; small
 * windows): MenuBar::fit_to_width picks the roomiest level at which every entry fits without
 * scrolling the tab strip. Each level keeps the ones before it; the sprout mark goes last. */
body.in-game-bar.fit-1 popup tab-bar tab {
    padding: 0 13dp;
}

/* RmlUi draws a box-shadow at the bar's unshrunk width, so a bar that had to give way showed a
 * second, wider rim running off the picture. The compact bar goes without its shadow. */
body.in-game-bar.fit-1 popup {
    box-shadow: none;
}

body.in-game-bar.fit-2 popup bar-status span.clock {
    display: none;
}

body.in-game-bar.fit-3 popup {
    padding: 0 8dp;
}

body.in-game-bar.fit-3 popup tab-bar tab {
    padding: 0 10dp;
}

body.in-game-bar.fit-3 popup mark {
    margin-right: 2dp;
}

body.in-game-bar.fit-3 popup divider {
    margin: 0 4dp;
}

body.in-game-bar.fit-3 popup bar-status {
    gap: 10dp;
    padding: 0 6dp 0 2dp;
}

body.in-game-bar.fit-4 popup bar-status span.fps {
    display: none;
}

body.in-game-bar.fit-5 popup mark {
    display: none;
}

/* Without the mark the first tab's focus ring needs room from the bar's rounded cap. */
body.in-game-bar.fit-5 popup {
    padding: 0 10dp;
}

/* ---- Overlay corner stack: FPS pill and cheats badge ---- */

hud-corner {
    position: absolute;
    z-index: 99;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    pointer-events: none;
    opacity: 1;
    transition: top 0.26s cubic-out, opacity 0.18s cubic-out;
}

/* A window reaches the corner (large Menu Size): the pills step aside instead of covering it. */
body.corner-covered hud-corner {
    opacity: 0;
}

hud-corner[corner=tl] { top: 12dp; left: 12dp; }
hud-corner[corner=tr] { top: 12dp; right: 12dp; flex-direction: row-reverse; }

/* Below the in-game bar while it is open (16dp + 64dp + 12dp). */
body.bar-open hud-corner[corner=tl],
body.bar-open hud-corner[corner=tr] {
    top: 92dp;
}
hud-corner[corner=bl] { bottom: 12dp; left: 12dp; }
hud-corner[corner=br] { bottom: 12dp; right: 12dp; flex-direction: row-reverse; }

hud-corner fps,
hud-corner fps[corner=tl],
hud-corner fps[corner=tr],
hud-corner fps[corner=bl],
hud-corner fps[corner=br] {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
}

cheats-badge {
    display: none;
    height: 26dp;
    padding: 0 12dp 0 8dp;
    border-radius: 13dp;
    border-width: 1dp;
    border-color: rgba(255, 210, 63, 70%);
    background-color: rgba(120, 20, 24, 82%);
    font-family: var(--font-family-heading);
    font-weight: 600;
    font-size: var(--font-size-xs);
    line-height: 24dp;
    color: var(--color-text);
    white-space: nowrap;
}

cheats-badge[open] {
    display: flex;
    align-items: center;
    gap: 5dp;
}

cheats-badge icon {
    width: 16dp;
    height: 16dp;
    font-size: 16dp;
    color: var(--color-sun);
}

/* ---- Toast stack: the overlay sets each toast's `top` ---- */

body toast {
    transition: filter 0.18s cubic-in, transform 0.18s cubic-in, top 0.24s cubic-out;
}

body toast[open] {
    transition: filter 0.16s cubic-out, transform 0.32s back-out, top 0.24s cubic-out;
}

toast heading icon {
    flex: 0 0 auto;
}

toast.info heading icon { color: var(--color-pik-blue-hi); }
toast.success heading icon { color: var(--color-leaf-hi); }
toast.warning heading icon,
toast.controller-warning heading icon { color: var(--color-sun); }
toast.error heading icon { color: #FF8A80; }
toast.achievement heading icon { color: var(--color-petal); }
toast.controller heading icon { color: var(--color-border); }

/* The menu hint: "Press [F1] or [Back] to open the menu", with key caps. */
toast.menu-notification {
    min-width: 0;
    padding: 12dp 22dp;
    decorator: none;
}

toast.menu-notification message {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: var(--font-size-lg);
    color: var(--color-text);
}

toast.menu-notification key-cap {
    display: block;
    min-width: 28dp;
    height: 28dp;
    padding: 0 8dp;
    border-radius: 7dp;
    font-family: var(--font-family-heading);
    font-weight: 600;
    font-size: var(--font-size-sm);
    line-height: 28dp;
    text-align: center;
    color: var(--color-text);
    background-color: rgba(var(--color-surface-rgb), 55%);
    box-shadow: inset 3dp 4dp 8dp 0 rgba(255, 255, 255, 16%), inset -3dp -5dp 10dp 0 rgba(5, 11, 26, 50%), 0 0 0 2dp rgba(111, 182, 222, 55%);
}

toast.menu-notification key-cap.pad {
    border-radius: 14dp;
}

toast.menu-notification icon {
    width: 22dp;
    height: 22dp;
    font-size: 22dp;
    color: var(--color-border);
}

/* ---- Accessibility ---- */

body.reduce-motion.reduce-motion.reduce-motion.reduce-motion.scrim {
    transition: background-color 0.08s linear-in-out;
}

body.high-contrast.high-contrast.high-contrast.high-contrast cheats-badge {
    background-color: #5A0A10;
    border-color: var(--color-sun);
}
