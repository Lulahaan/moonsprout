// Generated by CMake from packaging/windows/mppm.rc.in: the Windows icon and version resource.
#include <winver.h>

1 ICON "@MPPM_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MPPM_RC_VERSION@
PRODUCTVERSION @MPPM_RC_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Moonsprout"
            VALUE "FileVersion", "@MPPM_VERSION_STRING@"
            VALUE "InternalName", "mppm"
            VALUE "OriginalFilename", "Moonsprout.exe"
            VALUE "ProductName", "Moonsprout"
            VALUE "ProductVersion", "@MPPM_VERSION_STRING@"
            VALUE "LegalCopyright", "CC0 1.0. Not affiliated with Nintendo."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
